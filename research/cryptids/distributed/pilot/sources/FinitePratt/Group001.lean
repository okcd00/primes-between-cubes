theorem batch_449 (n : ℕ) (hlo : 449 ≤ n) (hhi : n < 513) :
    ∃ p : ℕ, p.Prime ∧ n ^ 3 < p ∧ p < (n + 1) ^ 3 := by
  apply checkBatch_sound (ps := ps_batch_449) (certs := cs_batch_449) (by decide +kernel) n hlo
  exact hhi

theorem group_001 : ∀ n : ℕ, 257 ≤ n → n < 513 → CubeAt n :=
  (splice (splice batch_257 batch_321) (splice batch_385 batch_449))
end CubePrime.Pratt
